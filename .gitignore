# Publication allowlist: local configuration, game files and new folders stay private.
/*
!/.gitignore
!/.gitattributes
!/readme.md
!/CHANGELOG.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/dependencies.json
!/requirements.txt
!/port.example.json

!/android/
/android/**
!/android/**/
!/android/**/*.c
!/android/**/*.h
!/android/**/*.java
!/android/**/*.xml

!/native/
/native/*
!/native/*.c
!/native/*.h
!/native/*.cpp

!/config/
/config/**
!/config/**/
!/config/**/*.json
!/config/tutorial-shaders/*.hlsl

!/tools/
/tools/**
!/tools/**/
!/tools/**/*.py
!/tools/**/*.ps1
!/tools/**/*.sh
!/tools/**/*.c
!/tools/**/*.java

!/tests/
/tests/*
!/tests/*.py
!/tests/*.c
!/tests/*.h
!/tests/*.java

!/reference/
/reference/*
!/reference/dlmalloc/
/reference/dlmalloc/*
!/reference/dlmalloc/malloc.c

**/__pycache__/
**/build/
**/.gradle/
**/.idea/
**/.vscode/
*.py[cod]
*.apk
*.aab
*.exe
*.dll
*.so
*.o
*.obj
*.class
*.dex
*.zip
*.7z
*.rar
*.vfs
*.obb
*.log
*.keystore
*.jks
*.pem
*.key
.env
.env.*
local.properties
port.json
STATE.md
AGENTS.md
